# Copie para .env.local e preencha. .env.local nao vai para o git.

# URL do webhook do Chat Trigger do workflow "Agendamento — Demo Web".
# Fica so aqui e na Vercel: o repositorio e publico.
# Formato: https://<host-do-n8n>/webhook/<webhookId>
# Exige o trigger em mode: webhook — em hostedChat essa URL serve a pagina de
# chat do proprio n8n, nao a API.
N8N_CHAT_WEBHOOK_URL=

# Basic auth do Chat Trigger (authentication: basicAuth no no).
# O Chat Trigger v1.4 nao oferece header auth — basic e a unica opcao
# utilizavel para chamada servidor-a-servidor.
#
# Gere a senha com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# Use SO caracteres base64url (A-Z a-z 0-9 _ -). O Next carrega .env com
# expansao de variaveis, entao um "$" no meio do valor e engolido em silencio:
# o arquivo mostra 32 caracteres e o processo recebe 28, dando 502 sem pista.
# Aspas simples ou duplas NAO protegem — so escapar como \$, que por sua vez
# nao vale no painel da Vercel. base64url evita o problema nos dois lugares.
N8N_CHAT_BASIC_AUTH_USER=
N8N_CHAT_BASIC_AUTH_PASSWORD=

# Opcionais — limites do Route Handler. Os defaults estao no codigo.
# DEMO_CHAT_BURST_LIMIT=8       # mensagens por IP por minuto
# DEMO_CHAT_HOURLY_LIMIT=40     # mensagens por IP por hora
# DEMO_CHAT_TIMEOUT_MS=120000   # teto de uma resposta do agente
